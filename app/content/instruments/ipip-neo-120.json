  "info": {
    "audience": "Adults who want a descriptive picture of their personality across the five-factor model.",
    "authors": "John A. Johnson",
    "durationMinutes": {
      "max": 20,
      "min": 10
    },
    "notFor": [
      "It is not a diagnosis.",
      "It is not a clinical assessment.",
      "It is not a measure of ability or intelligence.",
      "It is not a comparison against a population."
    ],
    "originalLanguage": "en",
    "responseScale": "A five-point accuracy scale, from Very Inaccurate to Very Accurate.",
    "whatYouGet": [
      "A score for each of the 5 domains.",
      "A score for each of the 30 facets.",
      "A short description of what a high score and a low score mean.",
      "A link that shares your result and a file that saves it."
    ],
    "year": 2014
  },
  "instructions": "Describe yourself as you generally are now, not as you wish to be in the future. Describe yourself as you honestly see yourself in relation to other people you know of the same sex as you are, and roughly your same age. There are no right or wrong answers.",
