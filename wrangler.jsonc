{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personality-test",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Only the API reaches the Worker script. A page request stays a static
    // asset serve, so it is not billed. See docs/D1-RESULTS.md section 7.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personality-test-results",
      "database_id": "4dd7eea5-f49a-46c1-8e57-c670a019e4a9",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    // Daily retention sweep. See docs/D1-RESULTS.md section 11.
    "crons": ["23 4 * * *"],
  },
  "routes": [{ "pattern": "test.farissaifuddin.com", "custom_domain": true }],
}
